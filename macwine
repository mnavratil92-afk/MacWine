#!/bin/bash
# MacWine - run Windows applications on macOS (Wine + DXVK + MoltenVK).
#
#   macwine create <bottle>                         create a new bottle (Windows 10, 64-bit)
#   macwine list [--json]                           list bottles
#   macwine run <bottle> <program.exe> [args...]    run a program in a bottle
#   macwine launch <bottle> <store> <id>            start a game (steam|epic|gog|ubisoft|exe)
#   macwine install <bottle> <store> <id>           install a game through its store
#   macwine setup-store <bottle> <store>            install and start a store launcher
#   macwine steam <bottle>                          shortcut for: setup-store <bottle> steam
#   macwine accounts [--json]                       connected stores and their status
#   macwine library <store> [--bottle <b>] [--json] owned + installed games of a store
#   macwine connect <store> [--bottle <b>]          connect a store; its bottle is named after the store
#                                                   (steam, epic, gog, ubisoft) and created when missing
#   macwine connect epic|gog --code-stdin           finish Epic/GOG sign-in (code on stdin)
#   macwine sync <store>                            refresh the cached owned-games list
#   macwine disconnect <store>                      remove the local link (store account untouched)
#   macwine set-key steam                           store a Steam Web API key in the Keychain
#   macwine open <file.exe|.msi> [--bottle <b>]     open a file (Finder double-click)
#   macwine shortcut <bottle> <store> <id> --name <name> [--dest <folder>] [--icon <image|exe>]
#                                                   create a .app shortcut with the program icon
#   macwine icon <program.exe> <output.png>         extract the icon from an .exe
#   macwine settings <bottle> [--json]              bottle settings
#   macwine d3dmetal status|import <GPTK .dmg>      DirectX 12 via Apple D3DMetal (user-provided)
#   macwine set <bottle> <key> <value>              fps <n|0>, graphics dxvk|wined3d|d3dmetal,
#                                                   windows win11|win10|win7, hud 0|1
#   macwine components list|install <bottle> <id...> Windows components (.NET, Visual C++, DirectX...)
#   macwine cfg <bottle>                            Wine configuration (winecfg)
#   macwine kill <bottle>                           stop all processes in a bottle
#   macwine version [--json]                        component versions
#   macwine runtime status|install [--json]         downloadable Wine runtime
#
# Options: --json (machine-readable output), --detach (start in background and return).
# Graphics: DXVK (DirectX 9-11 -> Vulkan -> MoltenVK -> Metal), msync synchronization.
set -euo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
SELF_DIR="$(dirname "$SELF")"
MACWINE_HOME="${MACWINE_HOME:-$HOME/MacWine}"
# Inside MacWine.app the CLI and the runtime are in Contents/Resources (older layout: Contents/MacOS/runtime).
# Runtime lookup: $MACWINE_RUNTIME, bundled in the app (dev builds), downloaded runtime
# (~/Library/Application Support/MacWine/runtimes/current), legacy ~/MacWine/runtime.
RUNTIMES="${MACWINE_RUNTIMES:-$HOME/Library/Application Support/MacWine/runtimes}"
RUNTIME_MANIFEST="${MACWINE_RUNTIME_MANIFEST:-$SELF_DIR/runtime.json}"
if [ -z "${MACWINE_RUNTIME:-}" ]; then
  for d in "$SELF_DIR/runtime" "$SELF_DIR/../MacOS/runtime" "$RUNTIMES/current"; do
    if [ -x "$d/lib/wine/x86_64-unix/wine" ]; then MACWINE_RUNTIME="$(cd "$d" && pwd)"; break; fi
  done
fi
RUNTIME="${MACWINE_RUNTIME:-$MACWINE_HOME/runtime}"
BOTTLES="$MACWINE_HOME/bottles"
WINE="$RUNTIME/lib/wine/x86_64-unix/wine"
WINESERVER="$RUNTIME/bin/wineserver"
TOOLS="$RUNTIME/lib/macwine"
# DXVK handles DirectX 10/11. DirectX 9 stays on Wine's own Direct3D (wined3d): DXVK's D3D9 pipelines
# fail to compile on MoltenVK, so DX9 games would start with a black screen.
DXVK_DLLS="d3d10 d3d10_1 d3d10core d3d11"
APP_BUNDLE_ID="cz.navratil.macwine"

STEAM_URL="https://cdn.cloudflare.steamstatic.com/client/installer/SteamSetup.exe"
EPIC_URL="https://launcher-public-service-prod06.ol.epicgames.com/launcher/api/installer/download/EpicGamesLauncherInstaller.msi"
GOG_URL="https://webinstallers.gog-statics.com/download/GOG_Galaxy_2.0.exe"
UBISOFT_URL="https://ubi.li/4vxt9"

STEAM_EXE='C:\Program Files (x86)\Steam\steam.exe'
EPIC_EXE='C:\Program Files (x86)\Epic Games\Launcher\Portal\Binaries\Win64\EpicGamesLauncher.exe'
GOG_EXE='C:\Program Files (x86)\GOG Galaxy\GalaxyClient.exe'
UBISOFT_EXE='C:\Program Files (x86)\Ubisoft\Ubisoft Game Launcher\UbisoftConnect.exe'

die() { echo "macwine: $*" >&2; exit 1; }

# --- options shared by all commands ---
JSON=0 DETACH=0
args=()
for a in "$@"; do
  case "$a" in
    --json) JSON=1 ;;
    --detach) DETACH=1 ;;
    *) args+=("$a") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

json_str() { # JSON string including quotes
  local s="${1//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/\\n}"; s="${s//$'\t'/\\t}"
  printf '"%s"' "$s"
}

# --- bottle settings: <bottle>/macwine.conf (key=value) ---
conf_get() { # bottle key default
  local f="$BOTTLES/$1/macwine.conf" v=""
  [ -f "$f" ] && v="$(grep -m1 "^$2=" "$f" | cut -d= -f2-)" || true
  # take over the old macwine-fps file
  if [ -z "$v" ] && [ "$2" = fps ] && [ -f "$BOTTLES/$1/macwine-fps" ]; then v="$(tr -dc 0-9 < "$BOTTLES/$1/macwine-fps")"; fi
  echo "${v:-$3}"
}
conf_set() { # bottle key value
  local f="$BOTTLES/$1/macwine.conf"
  touch "$f"
  grep -v "^$2=" "$f" > "$f.tmp" || true
  echo "$2=$3" >> "$f.tmp"
  mv "$f.tmp" "$f"
}
win_version() { # bottle
  local v
  v="$(grep -m1 -A3 '^\[Software\\\\Wine\]' "$BOTTLES/$1/user.reg" 2>/dev/null | grep -m1 '^"Version"=' | cut -d'"' -f4)" || true
  echo "${v:-win10}"
}
bottle_running() { # bottle -> 0 when the bottle's wineserver is running
  local st dev ino
  st="$(stat -f '%d %i' "$BOTTLES/$1" 2>/dev/null)" || return 1
  dev="${st% *}"; ino="${st#* }"
  local dir; dir="$(printf '/tmp/.wine-%s/server-%x-%x' "$(id -u)" "$dev" "$ino")"
  # a running wineserver keeps its "lock" file open; files left behind by a killed server do not count
  [ -S "$dir/socket" ] && [ -n "$(lsof -t "$dir/lock" 2>/dev/null)" ]
}

# --- DirectX 12 (and better DirectX 11) through Apple's D3DMetal from the Game Porting Toolkit ---
# MacWine never ships D3DMetal: every user downloads the Game Porting Toolkit from Apple (free Apple
# account) and imports it once. Bottles with graphics=d3dmetal then run on a copy of the runtime
# (APFS clone, no extra space) where Wine's d3d11/d3d12/dxgi are replaced by D3DMetal's.
D3DM_DIR="$MACWINE_HOME/d3dmetal"
D3DM_GPTK="$D3DM_DIR/gptk"
d3dmetal_installed() { [ -f "$D3DM_GPTK/external/libd3dshared.dylib" ] && [ -f "$D3DM_GPTK/wine/x86_64-unix/d3d12.so" ]; }

d3dmetal_runtime() { # -> runtime variant with D3DMetal overlaid (created once per runtime build)
  local key dest tmp
  key="$(cat "$RUNTIME/lib/macwine/runtime-version" 2>/dev/null || echo dev)-$(stat -f %i "$WINE")"
  dest="$D3DM_DIR/runtime-$key"
  if [ ! -x "$dest/lib/wine/x86_64-unix/wine" ]; then
    echo "Preparing D3DMetal runtime..." >&2
    tmp="$D3DM_DIR/.runtime.tmp"; rm -rf "${tmp:?}"
    cp -cR "$RUNTIME/" "$tmp"
    cp -c "$D3DM_GPTK"/wine/x86_64-windows/* "$tmp/lib/wine/x86_64-windows/"
    cp -c "$D3DM_GPTK"/wine/x86_64-unix/* "$tmp/lib/wine/x86_64-unix/"
    cp -c "$D3DM_GPTK/external/libd3dshared.dylib" "$tmp/lib/"
    mv "$tmp" "$dest"
  fi
  echo "$dest"
}

# Bottles created before MacWine 0.9.15 have their Windows user profile in C:\users\crossover (the user name
# of the Wine sources MacWine builds from). Wine now reports "macwine": move the profile once, while the bottle
# is stopped, fix the registry paths, and keep the old path as a link for programs that saved it.
migrate_user_profile() { # bottle
  local p="$BOTTLES/$1" u="$BOTTLES/$1/drive_c/users" f
  [ -e "$u/crossover" ] || return 0
  bottle_running "$1" && return 0
  if [ -d "$u/crossover" ] && [ ! -L "$u/crossover" ] && [ ! -e "$u/macwine" ]; then
    mv "$u/crossover" "$u/macwine" && ln -s macwine "$u/crossover" || return 0
    echo "Bottle '$1': Windows user profile moved to C:\\users\\macwine" >&2
  fi
  [ -d "$u/macwine" ] || return 0
  for f in user.reg system.reg userdef.reg; do
    [ -f "$p/$f" ] && grep -qi 'users\\\\crossover' "$p/$f" || continue
    [ -f "$p/$f.before-user-rename" ] || cp -p "$p/$f" "$p/$f.before-user-rename"
    /usr/bin/perl -pi -e 's/\\\\users\\\\crossover(?=\\\\|")/\\\\users\\\\macwine/gi' "$p/$f"
  done
}

setup_env() { # bottle
  export WINEPREFIX="$BOTTLES/$1"
  migrate_user_profile "$1"
  if [ "$(conf_get "$1" graphics dxvk)" = d3dmetal ]; then
    d3dmetal_installed || die "bottle '$1' uses D3DMetal, but it is not installed (macwine d3dmetal import <Game Porting Toolkit .dmg>)"
    RUNTIME="$(d3dmetal_runtime)"; WINE="$RUNTIME/lib/wine/x86_64-unix/wine"; WINESERVER="$RUNTIME/bin/wineserver"
    export CX_APPLEGPTK_LIBD3DSHARED_PATH="$RUNTIME/lib/libd3dshared.dylib" CX_ACTIVE_GRAPHICS_BACKEND=d3dmetal
    export DYLD_FALLBACK_FRAMEWORK_PATH="$D3DM_GPTK/external"
  fi
  export WINESERVER
  export WINEMSYNC=1
  export ROSETTA_ADVERTISE_AVX="${ROSETTA_ADVERTISE_AVX-1}"  # report AVX under Rosetta (newer games and Chromium require it)
  export WINEDEBUG="${WINEDEBUG:--all}"
  export DYLD_FALLBACK_LIBRARY_PATH="${MACWINE_MVK_DIR:+$MACWINE_MVK_DIR:}$RUNTIME/lib:/usr/lib"
  export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-none}"
  # MACWINE_LOG=1: Wine and DXVK debug logs in ~/MacWine/logs (inherited by games started from Steam too)
  if [ "${MACWINE_LOG:-$(conf_get "$1" log 0)}" = 1 ]; then
    LOGDIR="$MACWINE_HOME/logs/$1-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$LOGDIR"
    export WINEDEBUG="err+all,fixme-all" DXVK_LOG_LEVEL=info DXVK_LOG_PATH="$LOGDIR"
    echo "Logs: $LOGDIR" >&2
    exec 2>"$LOGDIR/wine.log"
  fi
  export DXVK_STATE_CACHE_PATH="$WINEPREFIX"
  # GStreamer for in-game videos (winegstreamer): plugins from the runtime, registry cache per user
  if [ -d "$RUNTIME/lib/gstreamer-1.0" ]; then
    export GST_PLUGIN_SYSTEM_PATH="$RUNTIME/lib/gstreamer-1.0"
    export GST_REGISTRY="$MACWINE_HOME/gstreamer-registry.x86_64.bin"
    export GST_REGISTRY_FORK=no
    unset GST_PLUGIN_PATH
  fi
  # In-game FPS display: MACWINE_HUD=1 or bottle setting hud=1
  if [ "${MACWINE_HUD:-$(conf_get "$1" hud 0)}" = 1 ]; then export DXVK_HUD="fps,frametimes,gpuload,compiler"; fi
  # FPS limit: MACWINE_FPS=<n>, otherwise bottle setting fps=<n>
  local fps="${MACWINE_FPS:-$(conf_get "$1" fps 0)}"
  if [ -n "$fps" ] && [ "$fps" != 0 ]; then export DXVK_FRAME_RATE="$fps"; fi
}

# Compatibility rules:
#  - the built-in browsers (Chromium) of Steam, Rockstar and other launchers get the arguments
#    they need to render under Wine
#  - Rockstar Launcher.exe uses wined3d instead of DXVK
#  - PlayGTAV.exe starts without BattlEye
# The arguments are added by MacWine's kernelbase.dll (patches/wine-macwine-compat.patch).
install_compat() {
  local reg dll
  reg="$(mktemp -t macwine).reg"
  {
    printf 'REGEDIT4\n\n'
    printf '[HKEY_CURRENT_USER\\Software\\MacWine\\Compat\\steamwebhelper.exe]\n'
    printf '"AppendArgs"="--no-sandbox --in-process-gpu --disable-gpu"\n'
    printf '"ForbiddenArg"="--type=crashpad-handler"\n\n'
    printf '[HKEY_CURRENT_USER\\Software\\MacWine\\Compat\\SocialClubHelper.exe]\n'
    printf '"AppendArgs"="--in-process-gpu --use-gl=angle --use-angle=swiftshader"\n\n'
    # GOG Galaxy and Ubisoft Connect render their UI with Chromium (CEF) like Steam
    printf '[HKEY_CURRENT_USER\\Software\\MacWine\\Compat\\GalaxyClient Helper.exe]\n'
    printf '"AppendArgs"="--no-sandbox --in-process-gpu --disable-gpu"\n'
    printf '"ForbiddenArg"="--type=crashpad-handler"\n\n'
    printf '[HKEY_CURRENT_USER\\Software\\MacWine\\Compat\\UplayWebCore.exe]\n'
    printf '"AppendArgs"="--no-sandbox --in-process-gpu --disable-gpu"\n'
    printf '"ForbiddenArg"="--type=crashpad-handler"\n\n'
    # Ubisoft Connect hosts the Chromium browser inside upc.exe itself - without these its window stays white
    printf '[HKEY_CURRENT_USER\\Software\\MacWine\\Compat\\upc.exe]\n'
    printf '"AppendArgs"="--no-sandbox --in-process-gpu --disable-gpu"\n\n'
    printf '[HKEY_CURRENT_USER\\Software\\MacWine\\Compat\\PlayGTAV.exe]\n'
    printf '"AppendArgs"="-nobattleye"\n\n'
    printf '[HKEY_CURRENT_USER\\Software\\Wine\\DllOverrides]\n"d3d9"="builtin"\n\n'
    printf '[HKEY_CURRENT_USER\\Software\\Wine\\AppDefaults\\Launcher.exe\\DllOverrides]\n'
    for dll in $DXVK_DLLS; do printf '"%s"="builtin"\n' "$dll"; done
  } > "$reg"
  "$WINE" regedit /S "$reg"
  # With the bottle already running (e.g. Steam open) "-w" would block until everything exits
  bottle_running "$(basename "$WINEPREFIX")" || "$WINESERVER" -w
  rm -f "$reg"
}

write_dll_overrides() { # native,builtin (DXVK) or builtin (wined3d)
  local dll reg
  reg="$(mktemp -t macwine).reg"
  {
    printf 'REGEDIT4\n\n[HKEY_CURRENT_USER\\Software\\Wine\\DllOverrides]\n'
    for dll in $DXVK_DLLS; do printf '"%s"="%s"\n' "$dll" "$1"; done
  } > "$reg"
  "$WINE" regedit /S "$reg"
  "$WINESERVER" -w
  rm -f "$reg"
}

COMPAT_VERSION=4   # bump when install_compat changes; bottles are updated on their next start
ensure_compat() { # bottle
  [ "$(conf_get "$1" compat 1)" = "$COMPAT_VERSION" ] && return 0
  install_compat >/dev/null 2>&1 && conf_set "$1" compat "$COMPAT_VERSION"
}

install_dxvk() { # copies the DXVK DLLs into the bottle and registers them
  local dll src="${MACWINE_DXVK_DIR:-$RUNTIME/lib/dxvk}"
  for dll in $DXVK_DLLS; do
    cp "$src/x86_64-windows/$dll.dll" "$WINEPREFIX/drive_c/windows/system32/"
    cp "$src/i386-windows/$dll.dll" "$WINEPREFIX/drive_c/windows/syswow64/"
  done
  write_dll_overrides native,builtin
}

# A Wine update (wineboot -u) replaces the DLLs in system32 with builtin ones; without this check DXVK
# would silently turn off after every new runtime. On a mismatch, finish the bottle update first.
ensure_dxvk() { # bottle
  [ "$(conf_get "$1" graphics dxvk)" = dxvk ] || return 0
  local src="${MACWINE_DXVK_DIR:-$RUNTIME/lib/dxvk}"
  cmp -s "$src/x86_64-windows/d3d11.dll" "$WINEPREFIX/drive_c/windows/system32/d3d11.dll" && return 0
  echo "Updating bottle and restoring DXVK..." >&2
  "$WINE" wineboot -u >/dev/null 2>&1 || true
  "$WINESERVER" -w
  install_dxvk
}

need_bottle() {
  [ -n "${1:-}" ] || die "missing bottle name"
  case "$1" in */*|.*) die "invalid bottle name: $1" ;; esac
  [ -d "$BOTTLES/$1" ] || die "bottle '$1' does not exist (create it: macwine create $1)"
}

unix_path() { # Windows path (C:\...) or Unix path -> Unix path inside the bottle
  case "$1" in
    [A-Za-z]:\\*|[A-Za-z]:/*)
      local d rest
      d="$(printf '%s' "${1:0:1}" | tr 'A-Z' 'a-z')"; rest="${1:2}"; rest="${rest//\\//}"
      if [ "$d" = c ]; then echo "$WINEPREFIX/drive_c$rest"; else echo "$WINEPREFIX/dosdevices/$d:$rest"; fi ;;
    *) echo "$1" ;;
  esac
}

wine_start() { # program [arguments...] - runs it in Wine (in the background with --detach)
  local dir
  dir="$(dirname "$(unix_path "$1")")"
  [ -d "$dir" ] && cd "$dir"
  if [ "$DETACH" = 1 ]; then
    nohup "$WINE" "$@" >/dev/null 2>&1 &
    disown || true
    exit 0
  fi
  exec "$WINE" "$@"
}

store_exe() { # store -> Windows path of its launcher
  case "$1" in
    steam) echo "$STEAM_EXE" ;; epic) echo "$EPIC_EXE" ;;
    gog) echo "$GOG_EXE" ;; ubisoft) echo "$UBISOFT_EXE" ;;
    *) die "unknown store: $1 (steam|epic|gog|ubisoft)" ;;
  esac
}

download() { # url file
  echo "Downloading $(basename "$2")..." >&2
  curl -fL --retry 3 -o "$2" "$1"
}

setup_store() { # bottle store - installs the launcher when it is missing
  local exe tmp
  exe="$(unix_path "$(store_exe "$2")")"
  [ -f "$exe" ] && return 0
  tmp="$(mktemp -d)"
  case "$2" in
    steam)   download "$STEAM_URL" "$tmp/SteamSetup.exe"; "$WINE" "$tmp/SteamSetup.exe" /S ;;
    epic)    download "$EPIC_URL" "$tmp/EpicInstaller.msi"; "$WINE" msiexec /i "$tmp/EpicInstaller.msi" /qn ;;
    gog)     download "$GOG_URL" "$tmp/GOG_Galaxy.exe"; "$WINE" "$tmp/GOG_Galaxy.exe" /VERYSILENT /NORESTART ;;
    ubisoft) download "$UBISOFT_URL" "$tmp/UbisoftConnectInstaller.exe"; "$WINE" "$tmp/UbisoftConnectInstaller.exe" /S ;;
  esac
  "$WINESERVER" -w
  rm -rf "$tmp"
  [ -f "$exe" ] || die "installing $2 failed ($exe is missing)"
}

store_url() { # action store id -> URL for the launcher
  case "$2:$1" in
    steam:launch)   echo "steam://rungameid/$3" ;;
    steam:install)  echo "steam://install/$3" ;;
    epic:launch)    echo "com.epicgames.launcher://apps/$3?action=launch&silent=true" ;;
    epic:install)   echo "com.epicgames.launcher://apps/$3?action=install" ;;
    ubisoft:launch) echo "uplay://launch/$3/0" ;;
    ubisoft:install) echo "uplay://install/$3" ;;
    *) die "action $1 is not supported for $2" ;;
  esac
}

# Finds the installed MacWine.app (for shortcuts, which must find it even after it was moved).
app_cli_path() {
  if [ -f "$SELF_DIR/../Info.plist" ]; then echo "$SELF"; return; fi
  local app
  app="$(mdfind "kMDItemCFBundleIdentifier == '$APP_BUNDLE_ID'" 2>/dev/null | head -1)" || true
  if [ -n "$app" ] && [ -x "$app/Contents/Resources/macwine" ]; then echo "$app/Contents/Resources/macwine"; else echo "$SELF"; fi
}

extract_icon() { # exe output.png
  local tool="$TOOLS/exeicon" tmp
  [ -x "$tool" ] || tool="$SELF_DIR/tools/exeicon"
  [ -x "$tool" ] || die "exeicon tool is missing (build it: tools/build-tools.sh)"
  tmp="$(mktemp -d)"
  "$tool" "$1" "$tmp/icon" >/dev/null || { rm -rf "$tmp"; return 1; }
  if [ -f "$tmp/icon.png" ]; then cp "$tmp/icon.png" "$2"
  else sips -s format png "$tmp/icon.ico" --out "$2" >/dev/null; fi
  rm -rf "$tmp"
}

make_icns() { # png output.icns
  local set s
  set="$(mktemp -d)/icon.iconset"; mkdir -p "$set"
  for s in 16 32 128 256 512; do
    sips -z $s $s "$1" --out "$set/icon_${s}x${s}.png" >/dev/null
    sips -z $((s*2)) $((s*2)) "$1" --out "$set/icon_${s}x${s}@2x.png" >/dev/null
  done
  iconutil -c icns "$set" -o "$2"
  rm -rf "$(dirname "$set")"
}

store_icon_exe() { # store id -> Unix path of the .exe that provides the icon (or empty)
  case "$1" in
    exe) unix_path "$2" ;;
    gog) if [[ "$2" =~ ^[0-9]+$ ]]; then local i; i="$(gog_info_file "$(basename "$WINEPREFIX")" "$2")"
           [ -n "$i" ] && printf '%s/%s' "$(dirname "$i")" "$("$JQ" -r '(.playTasks // []) | map(select(.isPrimary == true)) | first | .path // empty' "$i" | tr '\\' '/')"
         else unix_path "$2"; fi ;;
    *) unix_path "$(store_exe "$1")" ;;
  esac
}

# ---------------------------------------------------------------------------
# Stores: accounts, owned libraries, local installs (contract: .collab/store-contract.md)
# Secrets never leave the Keychain (service "MacWine") or the store's own sign-in.
# ---------------------------------------------------------------------------
ACCOUNTS="$MACWINE_HOME/accounts"
JQ=/usr/bin/jq
STORES="steam epic gog ubisoft"

keychain_get() { security find-generic-password -s MacWine -a "$1" -w 2>/dev/null || true; }

store_bottle() { # store -> bottle remembered by "connect", else the store's own bottle (named after it)
  local f="$ACCOUNTS/$1/bottle"
  if [ -f "$f" ] && [ -d "$BOTTLES/$(cat "$f")" ]; then cat "$f"; return; fi
  [ -d "$BOTTLES/$1" ] && echo "$1"
  return 0
}

steam_dir() { echo "$BOTTLES/$1/drive_c/Program Files (x86)/Steam"; }

steam_user() { # bottle -> "steamid64<TAB>persona" of the most recent signed-in user
  local f; f="$(steam_dir "$1")/config/loginusers.vdf"
  [ -f "$f" ] || return 0
  awk -F'"' '
    /^\t"7656[0-9]+"/ { id=$2; persona=""; recent=0 }
    /"PersonaName"/ { persona=$4 }
    /"MostRecent"/ { if ($4=="1") recent=1 }
    /^\t}/ { if (id!="") { if (recent || first=="") { first=id "\t" persona } ; if (recent) { print id "\t" persona; done=1; exit } } }
    END { if (!done && first!="") print first }' "$f"
}

steam_local_tsv() { # bottle -> "appid<TAB>name<TAB>installed(0/1)" for every app manifest in all libraries
  local sd lib libs f appid name flags
  sd="$(steam_dir "$1")"
  [ -f "$sd/steamapps/libraryfolders.vdf" ] || return 0
  libs="$(awk -F'"' '/"path"/ {print $4}' "$sd/steamapps/libraryfolders.vdf")"
  while IFS= read -r lib; do
    [ -n "$lib" ] || continue
    lib="$(WINEPREFIX="$BOTTLES/$1" unix_path "${lib//\\\\/\\}")"
    for f in "$lib"/steamapps/appmanifest_*.acf; do
      [ -f "$f" ] || continue
      appid="$(awk -F'"' '/^\t"appid"/ {print $4; exit}' "$f")"
      name="$(awk -F'"' '/^\t"name"/ {print $4; exit}' "$f")"
      flags="$(awk -F'"' '/^\t"StateFlags"/ {print $4; exit}' "$f")"
      [ "$appid" = 228980 ] && continue   # Steamworks Common Redistributables
      printf '%s\t%s\t%s\n' "$appid" "$name" "$(( (${flags:-0} & 4) ? 1 : 0 ))"
    done
  done <<< "$libs"
}

steam_sync() { # bottle -> refresh $ACCOUNTS/steam/owned.json via the official Web API (needs user's key)
  local key user id
  key="$(keychain_get steam-apikey)"; user="$(steam_user "$1")"; id="${user%%$'\t'*}"
  [ -n "$key" ] && [ -n "$id" ] || return 1
  mkdir -p "$ACCOUNTS/steam"
  # The key goes to curl via its config on stdin, so it never appears in the process list.
  printf 'url = "https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/?key=%s&steamid=%s&include_appinfo=1&include_played_free_games=1&format=json"\n' "$key" "$id" |
    curl -sf -m 30 -K - > "$ACCOUNTS/steam/owned.tmp" || { rm -f "$ACCOUNTS/steam/owned.tmp"; return 2; }
  # Without a "games" array (e.g. game details not visible) this is NOT an empty library - it is a failure.
  "$JQ" -e '.response.games | type == "array"' "$ACCOUNTS/steam/owned.tmp" >/dev/null || { rm -f "$ACCOUNTS/steam/owned.tmp"; return 3; }
  "$JQ" '[.response.games[]? | {id: (.appid|tostring), name: .name}]' "$ACCOUNTS/steam/owned.tmp" > "$ACCOUNTS/steam/owned.json"
  rm -f "$ACCOUNTS/steam/owned.tmp"
}

steam_sync_or_die() { # bottle
  local rc=0
  steam_sync "$1" || rc=$?
  case $rc in
    0) ;;
    1) die "Steam: sign in to Steam and add a Web API key to load the full library" ;;
    3) die "Steam: the Web API returned no game list - make sure your profile's game details are visible, then try again" ;;
    *) die "Steam: the Web API request failed (check the key and the network)" ;;
  esac
}

steam_cache_tsv() { # bottle -> "appid<TAB>name" of every GAME in the signed-in account's library.
  # The Steam client caches artwork for each app of the account's library (appcache/librarycache/<appid>);
  # names and types come from its appinfo.vdf. No API key needed - only a signed-in Steam client.
  local sd tool
  sd="$(steam_dir "$1")"
  [ -d "$sd/appcache/librarycache" ] && [ -f "$sd/appcache/appinfo.vdf" ] || return 0
  tool="$TOOLS/steamappinfo"; [ -x "$tool" ] || tool="$SELF_DIR/tools/steamappinfo"; [ -x "$tool" ] || return 0
  # shellcheck disable=SC2046
  "$tool" "$sd/appcache/appinfo.vdf" $(ls "$sd/appcache/librarycache" | grep -E '^[0-9]+$') 2>/dev/null |
    awk -F'\t' 'tolower($2)=="game" && $3!="" {print $1 "\t" $3}'
}

steam_library_json() { # bottle
  local owned="[]" local_json
  # With a key the owned list must load (fail loudly, the app keeps showing local data); without a key: local only.
  if [ -n "$(keychain_get steam-apikey)" ] && [ ! -f "$ACCOUNTS/steam/owned.json" ]; then steam_sync_or_die "$1"; fi
  if [ -f "$ACCOUNTS/steam/owned.json" ]; then owned="$(cat "$ACCOUNTS/steam/owned.json")"
  else owned="$(steam_cache_tsv "$1" | "$JQ" -R -s '[split("\n")[] | select(length>0) | split("\t") | {id: .[0], name: .[1]}]')"; fi
  local_json="$(steam_local_tsv "$1" | "$JQ" -R -s '[split("\n")[] | select(length>0) | split("\t") | {id: .[0], name: .[1], installed: (.[2]=="1")}]')"
  # Cover art: the Steam client's own cache first (portrait cover, then header), then Steam's CDN
  local lc art_json f id
  lc="$(steam_dir "$1")/appcache/librarycache"
  art_json="$(for f in "$lc"/*/library_600x900.jpg "$lc"/*/header.jpg; do
      [ -f "$f" ] || continue; id="$(basename "$(dirname "$f")")"; printf '%s\t%s\n' "$id" "$f"
    done | "$JQ" -R -s 'reduce (split("\n")[] | select(length>0) | split("\t")) as $x ({}; if .[$x[0]] then . else .[$x[0]] = ("file://" + ($x[1] | @uri | gsub("%2F"; "/"))) end)')"
  "$JQ" -n --argjson owned "$owned" --argjson local "$local_json" --arg bottle "$1" --argjson localart "$art_json" '
    def art(id): ($localart[id] // "https://cdn.cloudflare.steamstatic.com/steam/apps/\(id)/library_600x900.jpg");
    ($local | map({key: .id, value: .}) | from_entries) as $L |
    ($owned | map(.id)) as $O |
    [ $owned[] | {id, name, installed: ($L[.id].installed // false), bottle: $bottle, executable: null, artworkURL: art(.id), source: "owned"} ]
    + [ $local[] | select(.id as $i | $O | index($i) | not) | {id, name, installed, bottle: $bottle, executable: null, artworkURL: art(.id), source: "local"} ]
    | sort_by(.name | ascii_downcase)'
}

win_path() { # unix path inside the bottle -> C:\...
  local p="${1#"$BOTTLES/$2/drive_c"}"
  printf 'C:%s' "${p//\//\\}"
}

epic_local_json() { # bottle -> installed Epic games (launcher manifests)
  local d="$BOTTLES/$1/drive_c/ProgramData/Epic/EpicGamesLauncher/Data/Manifests" f
  ls "$d"/*.item >/dev/null 2>&1 || { echo '[]'; return; }
  "$JQ" -s --arg bottle "$1" '[ .[] | {id: .AppName, name: .DisplayName, installed: true, bottle: $bottle,
     executable: ((.InstallLocation // "") + "\\" + (.LaunchExecutable // "") | gsub("/"; "\\")), artworkURL: null, source: "local"} ]' "$d"/*.item
}

gog_local_json() { # bottle -> installed GOG games (goggame-*.info next to each game)
  local f dir out="" item
  while IFS= read -r f; do
    dir="$(dirname "$f")"
    item="$("$JQ" -c --arg bottle "$1" --arg dir "$(win_path "$dir" "$1")" '{id: (.gameId|tostring), name: .name, installed: true, bottle: $bottle,
       executable: ((.playTasks // []) | map(select(.isPrimary == true)) | first | if . then ($dir + "\\" + (.path|gsub("/"; "\\"))) else null end),
       artworkURL: null, source: "local"}' "$f" 2>/dev/null)" || continue
    out="$out$item"$'\n'
  done < <(find "$BOTTLES/$1/drive_c" -maxdepth 6 -name 'goggame-*.info' 2>/dev/null)
  printf '%s' "$out" | "$JQ" -s '.'
}

ubisoft_local_json() { # bottle -> installed Ubisoft games (registry)
  awk -v bottle="$1" '
    /^\[Software\\\\Wow6432Node\\\\Ubisoft\\\\Launcher\\\\Installs\\\\[0-9]+\]/ { match($0, /Installs\\\\[0-9]+/); id=substr($0, RSTART+10, RLENGTH-10); next }
    /^\[/ { id="" }
    id!="" && /^"InstallDir"=/ { dir=$0; sub(/^"InstallDir"="/, "", dir); sub(/"$/, "", dir); gsub(/\\\\/, "\\", dir); print id "\t" dir }
  ' "$BOTTLES/$1/system.reg" 2>/dev/null |
  "$JQ" -R -s --arg bottle "$1" '[split("\n")[] | select(length>0) | split("\t") |
     {id: .[0], name: (.[1] | rtrimstr("/") | rtrimstr("\\") | split("/") | last | split("\\") | last), installed: true,
      bottle: $bottle, executable: null, artworkURL: null, source: "local"}]'
}

ubisoft_owned_tsv() { # bottle -> "uplay_id<TAB>name<TAB>thumb" of the signed-in account's games.
  # Ubisoft has no public library API; Ubisoft Connect caches the configuration of every product of the
  # account (cache/configuration/configurations). The ownership list itself is encrypted, so this is the source.
  local f tool
  tool="$TOOLS/ubiconfig"; [ -x "$tool" ] || tool="$SELF_DIR/tools/ubiconfig"; [ -x "$tool" ] || return 0
  for f in "$BOTTLES/$1"/drive_c/users/*/AppData/Local/"Ubisoft Game Launcher"/cache/configuration/configurations; do
    [ -f "$f" ] && "$tool" "$f" 2>/dev/null
  done | sort -t$'\t' -k1,1 -u
}

ubisoft_library_json() { # bottle -> account games (launcher cache) merged with installed games (registry)
  local owned local_json
  owned="$(ubisoft_owned_tsv "$1" | "$JQ" -R -s '[split("\n")[] | select(length>0) | split("\t") |
     {id: .[0], name: .[1], artworkURL: (if (.[2] // "") | test("^[0-9a-f]+\\.(jpg|png)$") then "https://ubistatic3-a.akamaihd.net/orbit/uplay_launcher_3_0/assets/" + .[2] else null end)}]')"
  local_json="$(ubisoft_local_json "$1")"
  "$JQ" -n --argjson owned "$owned" --argjson local "$local_json" --arg bottle "$1" '
    ($local | map({key: .id, value: .}) | from_entries) as $L |
    ($owned | map(.id)) as $O |
    [ $owned[] | {id, name, installed: ($L[.id] != null), bottle: $bottle, executable: null, artworkURL, source: "owned"} ]
    + [ $local[] | select(.id as $i | $O | index($i) | not) ]
    | sort_by(.name | ascii_downcase)'
}

