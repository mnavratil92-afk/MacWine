gog_signed_in() { [ -s "$GOG_AUTH" ]; }

gog_account_name() { "$JQ" -r '.username // empty' "$ACCOUNTS/gog/user.json" 2>/dev/null || true; }

gog_token() { # -> valid access token (gogdl refreshes an expired one and saves it)
  "$(gogdl_bin)" --auth-config-path "$GOG_AUTH" auth 2>/dev/null | "$JQ" -r '.access_token // empty' 2>/dev/null
}

gog_api() { # url -> GET as the signed-in user; the token goes to curl on stdin, never in argv
  local t; t="$(gog_token)"; [ -n "$t" ] || return 1
  printf 'url = "%s"\nheader = "Authorization: Bearer %s"\n' "$1" "$t" | curl -sf -m 30 -K -
}

gog_login() { # authorization code (or the whole on_login_success address) on stdin
  local code tmp
  code="$(head -c 8192 | tr -d '[:space:]')"
  [[ "$code" =~ [?\&]code=([A-Za-z0-9_-]+) ]] && code="${BASH_REMATCH[1]}"
  [[ "$code" =~ ^[A-Za-z0-9_-]{16,}$ ]] || die "GOG: this does not look like a sign-in code"
  mkdir -p "$ACCOUNTS/gog"; tmp="$(umask 077; mktemp "$ACCOUNTS/gog/.token.XXXXXX")"
  printf 'url = "https://auth.gog.com/token?client_id=%s&client_secret=%s&grant_type=authorization_code&redirect_uri=%s&code=%s"\n' \
    "$GOG_CLIENT_ID" "$GOG_CLIENT_SECRET" "$GOG_REDIRECT_ENC" "$code" | curl -sf -m 30 -K - > "$tmp" || true
  unset code
  "$JQ" -e '.access_token and .refresh_token' "$tmp" >/dev/null 2>&1 \
    || { rm -f "$tmp"; die "GOG sign-in failed (the code is valid only once and for a short time)"; }
  (umask 077; "$JQ" --arg c "$GOG_CLIENT_ID" '{($c): (. + {loginTime: now})}' "$tmp" > "$GOG_AUTH")
  rm -f "$tmp" "$ACCOUNTS/gog/owned.ok"
  gog_api "https://embed.gog.com/userData.json" | "$JQ" '{username, userId}' > "$ACCOUNTS/gog/user.json" 2>/dev/null || true
}

gog_owned_json() { # -> [{id, name, artworkURL}] of every game on the account (all pages)
