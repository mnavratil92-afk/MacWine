  while [ "$page" -le "$pages" ] && [ "$page" -le 200 ]; do
    resp="$(gog_api "https://embed.gog.com/account/getFilteredProducts?mediaType=1&sortBy=title&page=$page")" || return 1
    printf '%s' "$resp" | "$JQ" -e '.products | type == "array"' >/dev/null 2>&1 || return 1
    pages="$(printf '%s' "$resp" | "$JQ" -r '.totalPages // 1')"
    all="$(printf '%s' "$resp" | "$JQ" --argjson all "$all" '$all + [.products[] | select(.isGame != false) |
      {id: (.id|tostring), name: .title, windows: (.worksOn.Windows // true),
       artworkURL: (if (.image // "") != "" then ("https:" + .image + "_196.jpg") else null end)}]')"
    page=$((page + 1))
  done
  printf '%s' "$all"
}

gog_library_json() { # bottle -> owned (GOG API) merged with games installed in the bottle
