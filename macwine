winetricks_bin() {
  local bin="$MACWINE_HOME/tools/winetricks-$WINETRICKS_VERSION"
  if [ ! -x "$bin" ]; then
    mkdir -p "$MACWINE_HOME/tools"
    echo "Downloading winetricks $WINETRICKS_VERSION..." >&2
    curl -fL --retry 3 -o "$bin.part" "$WINETRICKS_URL"
    [ "$(shasum -a 256 "$bin.part" | cut -d' ' -f1)" = "$WINETRICKS_SHA256" ] || { rm -f "$bin.part"; die "winetricks checksum mismatch - download refused"; }
    chmod +x "$bin.part"; mv "$bin.part" "$bin"
  fi
  echo "$bin"
}

account_json() { # store -> one JSON object for "accounts"
  local s="$1" b user id persona key st msg conn=false full=false
  b="$(store_bottle "$s")"
  case "$s" in
    steam)
      if [ -z "$b" ]; then st=launcher-missing; msg="Steam is not installed in any bottle. Connect Steam to install it."
      else
        user="$(steam_user "$b")"; id="${user%%$'\t'*}"; persona="${user#*$'\t'}"
        key="$(keychain_get steam-apikey)"
        if [ -z "$id" ]; then st=needs-login; msg="Sign in to Steam in bottle '$b'."
        else conn=true
          if [ -z "$key" ] && [ -n "$(steam_cache_tsv "$b" | head -1)" ]; then st=ok; full=true; msg="Full library loaded from your Steam account."
          elif [ -z "$key" ]; then st=needs-sync; msg="Signed in. Open Steam once so it can load your library."
          elif [ -f "$ACCOUNTS/steam/owned.json" ]; then st=ok; full=true; msg="Full library loaded."
          else st=needs-sync; msg="Key saved. Refresh to load the full library."; fi
        fi
      fi ;;
    epic)
      [ -f "$ACCOUNTS/epic/bottle" ] && b="$(cat "$ACCOUNTS/epic/bottle")"
      if epic_signed_in; then conn=true; st=needs-sync; persona="$(epic_account_name)"; msg="Signed in. Refresh to load the full library."
        if [ -f "$ACCOUNTS/epic/owned.ok" ]; then full=true; st=ok; msg="Full library loaded."; fi
        [ -n "$b" ] || { st=needs-bottle; msg="Signed in. Choose a bottle for Epic games."; }
      else st=needs-login; msg="Sign in with your Epic Games account."; fi ;;
    gog)
      [ -f "$ACCOUNTS/gog/bottle" ] && b="$(cat "$ACCOUNTS/gog/bottle")"
      if gog_signed_in; then conn=true; st=needs-sync; persona="$(gog_account_name)"; msg="Signed in. Refresh to load the full library."
        if [ -f "$ACCOUNTS/gog/owned.ok" ]; then full=true; st=ok; msg="Full library loaded."; fi
        [ -n "$b" ] || { st=needs-bottle; msg="Signed in. Choose a bottle for GOG games."; }
      else st=needs-login; msg="Sign in with your GOG account."; fi ;;
    ubisoft)
      if [ -z "$b" ]; then st=launcher-missing; msg="Connect Ubisoft to install Ubisoft Connect."
      elif [ -n "$(ubisoft_owned_tsv "$b" | head -1)" ]; then conn=true; st=ok; full=true; msg="Library loaded from Ubisoft Connect."
      else conn=true; st=needs-sync; msg="Sign in to Ubisoft Connect once so MacWine can read your library."; fi ;;
  esac
  "$JQ" -n --arg store "$s" --argjson connected "$conn" --arg accountName "${persona:-}" --arg bottle "$b" \
    --argjson fullLibrary "$full" --arg status "$st" --arg message "$msg" \
    '{store: $store, connected: $connected, accountName: (if $accountName=="" then null else $accountName end),
      bottle: (if $bottle=="" then null else $bottle end), fullLibrary: $fullLibrary, status: $status, message: $message}'
}

library_json() { # store bottle
  case "$1" in
    steam) steam_library_json "$2" ;;
    epic) epic_library_json "$2" ;;
    gog) gog_library_json "$2" ;;
    ubisoft) ubisoft_library_json "$2" ;;
  esac
}

# --- downloadable runtime (release builds ship the app without it) ---
runtime_installed_version() { # version of the runtime in use, "bundled" (inside this app), "legacy" or empty
  if [ -f "$RUNTIME/lib/macwine/runtime-version" ]; then cat "$RUNTIME/lib/macwine/runtime-version"
  elif [ -x "$WINE" ]; then
    case "$(cd "$RUNTIME" && pwd -P)" in
      "$(cd "$SELF_DIR" && pwd -P)/runtime"|"$(cd "$SELF_DIR/.." && pwd -P)/MacOS/runtime") echo bundled ;;
      *) echo legacy ;;   # e.g. ~/MacWine/runtime from a developer build - never satisfies a pinned version
    esac
  fi
}
manifest_get() { "$JQ" -r ".$1 // empty" "$RUNTIME_MANIFEST" 2>/dev/null || true; }

runtime_install() { # downloads, verifies and activates the runtime from runtime.json
  local ver url sha size tmp got pct=-1 p dest
  [ -f "$RUNTIME_MANIFEST" ] || die "no runtime manifest ($RUNTIME_MANIFEST) - this build bundles its runtime"
  ver="$(manifest_get version)"; url="$(manifest_get url)"; sha="$(manifest_get sha256)"; size="$(manifest_get size)"
  [ -n "$ver" ] && [ -n "$url" ] && [ -n "$sha" ] || die "invalid runtime manifest"
  case "$url" in
    https://*) ;;
    file://*) [ "${MACWINE_DEV_ALLOW_FILE_URL:-0}" = 1 ] || die "runtime URL must be https" ;;  # local release testing only
    *) die "runtime URL must be https" ;;
  esac
  dest="$RUNTIMES/$ver"
  if [ -x "$dest/lib/wine/x86_64-unix/wine" ]; then ln -sfn "$ver" "$RUNTIMES/current"; return 0; fi
  mkdir -p "$RUNTIMES"
  tmp="$(mktemp -d "$RUNTIMES/.download.XXXXXX")"
  curl -fsL --retry 3 -o "$tmp/runtime.tar.xz" "$url" &
  local cpid=$!
  while kill -0 "$cpid" 2>/dev/null; do
    if [ -n "$size" ] && [ "$size" -gt 0 ] && [ -f "$tmp/runtime.tar.xz" ]; then
      got="$(stat -f %z "$tmp/runtime.tar.xz")"; p=$(( got * 100 / size )); [ "$p" -gt 99 ] && p=99
      if [ "$p" != "$pct" ]; then pct=$p; echo "progress $p" >&2; fi
    fi
    sleep 1
  done
  wait "$cpid" || { rm -rf "${tmp:?}"; die "runtime download failed"; }
  echo "progress 100" >&2
  [ "$(shasum -a 256 "$tmp/runtime.tar.xz" | cut -d' ' -f1)" = "$sha" ] || { rm -rf "${tmp:?}"; die "runtime checksum mismatch - download refused"; }
  echo "extracting" >&2
  mkdir -p "$tmp/x"
  tar -xJf "$tmp/runtime.tar.xz" -C "$tmp/x" || { rm -rf "${tmp:?}"; die "runtime archive is damaged"; }
  [ -x "$tmp/x/runtime/lib/wine/x86_64-unix/wine" ] || { rm -rf "${tmp:?}"; die "runtime archive has unexpected contents"; }
  xattr -dr com.apple.quarantine "$tmp/x/runtime" 2>/dev/null || true
  mv "$tmp/x/runtime" "$dest"
  rm -rf "${tmp:?}"
  ln -sfn "$ver" "$RUNTIMES/current"
}

cmd="${1:-}"
case "$cmd" in
  runtime|""|-h|--help|help) ;;
  *) [ -x "$WINE" ] || die "Wine runtime not found - run: macwine runtime install" ;;
esac

shift || true
case "$cmd" in
  runtime)
    sub="${1:-status}"
    req="$(manifest_get version)"; inst="$(runtime_installed_version)"
    case "$sub" in
      status)
        up=false
        # A pinned runtime (runtime.json) is satisfied only by exactly that version or by a runtime bundled in this app.
        if [ -n "$inst" ] && { [ -z "$req" ] || [ "$inst" = "$req" ] || [ "$inst" = bundled ]; }; then up=true; fi
        if [ "$JSON" = 1 ]; then
          "$JQ" -n --arg i "$inst" --arg r "$req" --argjson u "$up" --arg p "$([ -x "$WINE" ] && echo "$RUNTIME")" \
            '{installed: (if $i=="" then null else $i end), required: (if $r=="" then null else $r end), upToDate: $u, path: (if $p=="" then null else $p end)}'
        else echo "installed: ${inst:-none}, required: ${req:-any}, up to date: $up"; fi ;;
      install)
        runtime_install
        [ "$JSON" = 1 ] && "$JQ" -n --arg v "$(manifest_get version)" '{installed: $v}' || echo "Runtime $(manifest_get version) installed" ;;
      *) die "usage: macwine runtime status|install" ;;
    esac
    ;;
  create)
    [ -n "${1:-}" ] || die "missing bottle name"
    case "$1" in */*|.*) die "invalid bottle name: $1" ;; esac
    [ ! -e "$BOTTLES/$1" ] || die "bottle '$1' already exists"
    mkdir -p "$BOTTLES"
    setup_env "$1"
    [ "$JSON" = 1 ] || echo "Creating bottle '$1'..."
    "$WINE" wineboot --init >/dev/null 2>&1
    "$WINE" reg add 'HKCU\Software\Wine' /v Version /d win10 /f >/dev/null 2>&1
    "$WINESERVER" -w
    install_dxvk >/dev/null 2>&1
    install_compat >/dev/null 2>&1
    conf_set "$1" graphics dxvk; conf_set "$1" compat "$COMPAT_VERSION"
    if [ "$JSON" = 1 ]; then printf '{"name":%s,"path":%s}\n' "$(json_str "$1")" "$(json_str "$WINEPREFIX")"
    else echo "Done: $WINEPREFIX"; fi
    ;;
  list)
    if [ "$JSON" = 1 ]; then
      first=1; printf '['
      for d in "$BOTTLES"/*/; do
        [ -d "$d" ] || continue
        b="$(basename "$d")"
        [ "$first" = 1 ] || printf ','; first=0
        if bottle_running "$b"; then r=true; else r=false; fi
        printf '{"name":%s,"path":%s,"fps":%s,"graphics":%s,"windows":%s,"running":%s}' \
          "$(json_str "$b")" "$(json_str "${d%/}")" "$(conf_get "$b" fps 0)" \
          "$(json_str "$(conf_get "$b" graphics dxvk)")" "$(json_str "$(win_version "$b")")" "$r"
      done
      printf ']\n'
    else
      ls -1 "$BOTTLES" 2>/dev/null || true
    fi
    ;;
  settings)
    need_bottle "${1:-}"
    if bottle_running "$1"; then r=true; else r=false; fi
    if [ "$JSON" = 1 ]; then
      printf '{"fps":%s,"graphics":%s,"windows":%s,"msync":true,"hud":%s,"running":%s}\n' \
        "$(conf_get "$1" fps 0)" "$(json_str "$(conf_get "$1" graphics dxvk)")" \
        "$(json_str "$(win_version "$1")")" "$([ "$(conf_get "$1" hud 0)" = 1 ] && echo true || echo false)" "$r"
    else
      echo "fps=$(conf_get "$1" fps 0)"; echo "graphics=$(conf_get "$1" graphics dxvk)"
      echo "windows=$(win_version "$1")"; echo "hud=$(conf_get "$1" hud 0)"; echo "running=$r"
    fi
    ;;
  set)
    need_bottle "${1:-}"
    b="$1"; key="${2:-}"; val="${3:-}"
    [ -n "$key" ] && [ -n "$val" ] || die "usage: macwine set <bottle> <key> <value>"
    case "$key" in
      fps)  [[ "$val" =~ ^[0-9]+$ ]] || die "fps must be a number"; conf_set "$b" fps "$val"; rm -f "$BOTTLES/$b/macwine-fps" ;;
      hud)  [[ "$val" =~ ^[01]$ ]] || die "hud must be 0 or 1"; conf_set "$b" hud "$val" ;;
      log)  [[ "$val" =~ ^[01]$ ]] || die "log must be 0 or 1"; conf_set "$b" log "$val" ;;
      graphics)
        setup_env "$b"
        case "$val" in
          dxvk) conf_set "$b" graphics dxvk; install_dxvk >/dev/null 2>&1 ;;
          wined3d) conf_set "$b" graphics wined3d; write_dll_overrides builtin >/dev/null 2>&1 ;;
          d3dmetal)
            d3dmetal_installed || die "D3DMetal is not installed (macwine d3dmetal import <Game Porting Toolkit .dmg>)"
            write_dll_overrides builtin >/dev/null 2>&1; conf_set "$b" graphics d3dmetal ;;
          *) die "graphics must be dxvk, wined3d or d3dmetal" ;;
        esac ;;
      windows)
        case "$val" in win11|win10|win81|win8|win7) ;; *) die "windows must be one of: win11 win10 win81 win8 win7" ;; esac
        setup_env "$b"; "$WINE" reg add 'HKCU\Software\Wine' /v Version /d "$val" /f >/dev/null 2>&1; "$WINESERVER" -w ;;
      *) die "unknown key: $key (fps, graphics, windows, hud)" ;;
    esac
    [ "$JSON" = 1 ] || echo "$key=$val"
    ;;
  run)
    need_bottle "${1:-}"; setup_env "$1"; b="$1"; shift
    [ -n "${1:-}" ] || die "missing program to run"
    ensure_dxvk "$b"; ensure_compat "$b"
    wine_start "$@"
    ;;
  launch|install)
    need_bottle "${1:-}"; setup_env "$1"; b="$1"
    store="${2:-}"; id="${3:-}"
    [ -n "$store" ] && [ -n "$id" ] || die "usage: macwine $cmd <bottle> <store> <id>"
    ensure_dxvk "$b"; ensure_compat "$b"
    case "$store" in
      exe)
        [ "$cmd" = launch ] || die "install is not supported for $store"
        wine_start "$id" ;;
      gog)
        # Older shortcuts pass the game's .exe instead of the GOG product id
        if ! [[ "$id" =~ ^[0-9]+$ ]]; then [ "$cmd" = launch ] || die "usage: macwine install <bottle> gog <product id>"; wine_start "$id"; fi
        info="$(gog_info_file "$b" "$id")"
        if [ "$cmd" = install ]; then
          gog_signed_in || die "GOG is not connected (macwine connect gog)"
          [ -z "$info" ] || die "this GOG game is already installed"
          gd="$(gogdl_bin)"
          mkdir -p "$ACCOUNTS/gog/logs" "$WINEPREFIX/drive_c/GOG Games"
          log="$ACCOUNTS/gog/logs/install-$id.log"
          set -- "$gd" --auth-config-path "$GOG_AUTH" download "$id" --platform windows --with-dlcs \
            --path "$WINEPREFIX/drive_c/GOG Games" --support "$WINEPREFIX/drive_c/GOG Games/.support/$id"
          [ "$JSON" = 1 ] && "$JQ" -n --arg l "$log" '{store: "gog", log: $l}'
          if [ "$DETACH" = 1 ]; then nohup "$@" > "$log" 2>&1 & disown || true; exit 0; fi
          exec "$@"
        fi
        [ -n "$info" ] || die "this GOG game is not installed in bottle $b"
        gdir="$(dirname "$info")"
        task="$("$JQ" -c '(.playTasks // []) | (map(select(.isPrimary == true and (.type // "FileTask") == "FileTask")) + map(select((.type // "FileTask") == "FileTask"))) | first // empty' "$info")"
        [ -n "$task" ] || die "this GOG game has no launch task"
        exe="$gdir/$(printf '%s' "$task" | "$JQ" -r '.path' | tr '\\' '/')"
        wd="$(printf '%s' "$task" | "$JQ" -r '.workingDir // empty' | tr '\\' '/')"
        [ -n "$wd" ] && wd="$gdir/$wd" || wd="$(dirname "$exe")"
        [ -f "$exe" ] || die "the game's program was not found: $exe"
        cd "$wd"
        # shellcheck disable=SC2046
        set -- "$WINE" "$exe" $(printf '%s' "$task" | "$JQ" -r '.arguments // empty')
        if [ "$DETACH" = 1 ]; then nohup "$@" >/dev/null 2>&1 & disown || true; exit 0; fi
        exec "$@" ;;
      epic)
        leg="$(legendary_bin)"
        epic_signed_in || die "Epic is not connected (macwine connect epic)"
        if [ "$cmd" = install ]; then
          mkdir -p "$ACCOUNTS/epic/logs" "$WINEPREFIX/drive_c/Games"
          log="$ACCOUNTS/epic/logs/install-$id.log"
          [ "$JSON" = 1 ] && "$JQ" -n --arg l "$log" '{store: "epic", log: $l}'
          if [ "$DETACH" = 1 ]; then
            nohup "$leg" -y install "$id" --platform Windows --base-path "$WINEPREFIX/drive_c/Games" > "$log" 2>&1 &
            disown || true; exit 0
          fi
          exec "$leg" -y install "$id" --platform Windows --base-path "$WINEPREFIX/drive_c/Games"
        fi
        if "$leg" list-installed --json 2>/dev/null | "$JQ" -e --arg id "$id" 'any(.[]; .app_name == $id)' >/dev/null; then
          set -- "$leg" launch "$id" --wine "$WINE" --wine-prefix "$WINEPREFIX"
          if [ "$DETACH" = 1 ]; then nohup "$@" >/dev/null 2>&1 & disown || true; exit 0; fi
          exec "$@"
        fi
        setup_store "$b" epic
        wine_start "$(store_exe epic)" "$(store_url "$cmd" epic "$id")" ;;
      steam|ubisoft)
        setup_store "$b" "$store"
        if [ "$store" = steam ]; then wine_start "$(store_exe steam)" -silent "$(store_url "$cmd" steam "$id")"
        else wine_start "$(store_exe "$store")" "$(store_url "$cmd" "$store" "$id")"; fi ;;
      *) die "unknown store: $store" ;;
    esac
    ;;
  setup-store|steam)
    if [ "$cmd" = steam ]; then set -- "${1:-}" steam; fi
    need_bottle "${1:-}"; setup_env "$1"; b="$1"; store="${2:-}"
    [ -n "$store" ] || die "usage: macwine setup-store <bottle> steam|epic|gog|ubisoft"
    ensure_dxvk "$b"; ensure_compat "$b"
    setup_store "$b" "$store"
    wine_start "$(store_exe "$store")"
    ;;
  open)
    file="${1:-}"; b=""
    [ -f "$file" ] || die "file not found: $file"
    if [ "${2:-}" = --bottle ]; then b="${3:-}"; fi
    if [ -z "$b" ]; then echo "macwine: choose a bottle (--bottle <name>)" >&2; exit 3; fi
    need_bottle "$b"; setup_env "$b"; ensure_dxvk "$b"
    case "$(printf '%s' "$file" | tr 'A-Z' 'a-z')" in
      *.msi) wine_start msiexec /i "$("$WINE" winepath -w "$file" 2>/dev/null)" ;;
      *)     wine_start "$file" ;;
    esac
    ;;
  icon)
    [ -f "${1:-}" ] && [ -n "${2:-}" ] || die "usage: macwine icon <program.exe> <output.png>"
    extract_icon "$1" "$2" || die "no icon found in: $1"
    if [ "$JSON" = 1 ]; then printf '{"png":%s}\n' "$(json_str "$2")"; else echo "$2"; fi
    ;;
  shortcut)
    need_bottle "${1:-}"; b="$1"; store="${2:-}"; id="${3:-}"; shift 3 || true
    name="" dest="$HOME/Applications" icon=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --name) name="${2:-}"; shift 2 ;;
        --icon) icon="${2:-}"; shift 2 ;;
        --dest) dest="${2:-}"; shift 2 ;;
        *) die "unknown option: $1" ;;
      esac
    done
    [ -n "$store" ] && [ -n "$id" ] && [ -n "$name" ] || die "usage: macwine shortcut <bottle> <store> <id> --name <name> [--dest <folder>] [--icon <image|exe>]"
    case "$name" in */*) die "name must not contain /" ;; esac
    WINEPREFIX="$BOTTLES/$b"
    app="$dest/$name.app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
    cli="$(app_cli_path)"
    # The shortcut finds MacWine.app by its bundle ID (works even after it was moved); fixed path as a fallback.
    cat > "$app/Contents/MacOS/launcher" <<EOF
#!/bin/bash
# Zastupce MacWine: $name
cli="\$(mdfind "kMDItemCFBundleIdentifier == '$APP_BUNDLE_ID'" 2>/dev/null | head -1)/Contents/Resources/macwine"
[ -x "\$cli" ] || cli=$(printf '%q' "$cli")
exec "\$cli" launch $(printf '%q %q %q' "$b" "$store" "$id") --detach
EOF
    chmod +x "$app/Contents/MacOS/launcher"
    sid="$(printf '%s' "$b-$store-$id" | shasum | cut -c1-12)"
    cat > "$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>$APP_BUNDLE_ID.shortcut.$sid</string>
  <key>CFBundleName</key><string>$(printf '%s' "$name" | sed 's/&/\&amp;/g; s/</\&lt;/g')</string>
  <key>CFBundleExecutable</key><string>launcher</string>
  <key>CFBundleIconFile</key><string>icon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.games</string>
  <key>LSUIElement</key><true/>
</dict></plist>
EOF
    # Icon: --icon (image or .exe), otherwise the icon of the program / store launcher
    png="$(mktemp -t macwine).png"
    case "$(printf '%s' "$icon" | tr 'A-Z' 'a-z')" in
      "") iexe="$(store_icon_exe "$store" "$id")"; [ -f "$iexe" ] && extract_icon "$iexe" "$png" 2>/dev/null || rm -f "$png" ;;
      *.exe|*.dll) extract_icon "$icon" "$png" 2>/dev/null || rm -f "$png" ;;
      *) sips -s format png "$icon" --out "$png" >/dev/null 2>&1 || rm -f "$png" ;;
    esac
    if [ -s "$png" ]; then make_icns "$png" "$app/Contents/Resources/icon.icns"; fi
    rm -f "$png"
    touch "$app"
    if [ "$JSON" = 1 ]; then printf '{"app":%s}\n' "$(json_str "$app")"; else echo "Shortcut: $app"; fi
    ;;
  accounts)
    if [ "$JSON" = 1 ]; then
      for s in $STORES; do account_json "$s"; done | "$JQ" -s '.'
    else
      for s in $STORES; do account_json "$s" | "$JQ" -r '"\(.store): \(.status) - \(.message)"'; done
    fi
    ;;
  library)
    store="${1:-}"; b=""
    case "$store" in steam|epic|gog|ubisoft) ;; *) die "usage: macwine library steam|epic|gog|ubisoft [--bottle <b>]" ;; esac
    if [ "${2:-}" = --bottle ]; then b="${3:-}"; else b="$(store_bottle "$store")"; fi
    if [ -z "$b" ] && [ "$store" = epic ] && [ -f "$ACCOUNTS/epic/bottle" ]; then b="$(cat "$ACCOUNTS/epic/bottle")"; fi
    if [ -z "$b" ]; then out='[]'; else need_bottle "$b"; WINEPREFIX="$BOTTLES/$b"; out="$(library_json "$store" "$b")"; fi
    if [ "$JSON" = 1 ]; then printf '%s\n' "$out"
    else printf '%s' "$out" | "$JQ" -r '.[] | "\(if .installed then "[installed]" else "[owned]    " end) \(.name) (\(.id))"'; fi
    ;;
  connect)
    # Every store has its own bottle named after the store (created on first connect); --bottle overrides it.
    store="${1:-}"; shift || true
    case "$store" in steam|epic|gog|ubisoft) ;; *) die "usage: macwine connect steam|epic|gog|ubisoft [--bottle <b>] [--code-stdin]" ;; esac
    b="$store"; codein=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --bottle) b="${2:-}"; shift 2 || true ;;
        --code-stdin) codein=1; shift ;;
        *) die "unknown option: $1" ;;
      esac
    done
    case "$b" in ""|*/*|.*) die "invalid bottle name: $b" ;; esac
    if [ ! -d "$BOTTLES/$b" ]; then
      [ "$JSON" = 1 ] || echo "Creating bottle '$b' for $store..." >&2
      MACWINE_LOG=0 "$SELF" create "$b" --json >/dev/null || die "could not create bottle '$b'"
    fi
    mkdir -p "$ACCOUNTS/$store"; echo "$b" > "$ACCOUNTS/$store/bottle"
    if [ "$store" = gog ] && [ "$codein" = 1 ]; then
      gogdl_bin >/dev/null
      gog_login
      [ "$JSON" = 1 ] && "$JQ" -n --arg n "$(gog_account_name)" '{store: "gog", connected: true, accountName: (if $n=="" then null else $n end)}' || echo "GOG: signed in as $(gog_account_name)"
      exit 0
    fi
    if [ "$store" = epic ] && [ "$codein" = 1 ]; then
      # The one-time authorization code is read from stdin and handed to Legendary on its stdin -
      # never as a process argument. BROWSER=true stops Legendary from opening a browser itself.
      # Accepts the bare code, the whole JSON page Epic shows, or the redirect URL (...?code=...)
      code="$(head -c 8192 | tr -d '[:space:]')"
      if [[ "$code" =~ \"authorizationCode\":\"([0-9a-fA-F]+)\" ]] || [[ "$code" =~ [?\&]code=([0-9a-fA-F]+) ]]; then
        code="${BASH_REMATCH[1]}"
      fi
      code="$(printf '%s' "$code" | tr -d '"')"
      [[ "$code" =~ ^[0-9a-fA-F]{20,64}$ ]] || die "Epic: this does not look like an authorization code"
      leg="$(legendary_bin)"
      printf '%s\n' "$code" | BROWSER=/usr/bin/true "$leg" auth --disable-webview >/dev/null 2>&1 \
        || { unset code; die "Epic sign-in failed (the code is valid only once and for a short time)"; }
      unset code
      epic_signed_in || die "Epic sign-in failed"
      [ "$JSON" = 1 ] && "$JQ" -n --arg n "$(epic_account_name)" '{store: "epic", connected: true, accountName: $n}' || echo "Epic: signed in as $(epic_account_name)"
      exit 0
    fi
    [ "$codein" = 0 ] || die "--code-stdin is only for epic and gog"
    if [ "$store" = epic ]; then
      # Epic: user signs in on epicgames.com (opened by the app), the page shows a one-time authorization code.
      legendary_bin >/dev/null
      [ "$JSON" = 1 ] && "$JQ" -n --arg u "$EPIC_LOGIN_URL" '{store: "epic", loginURL: $u, next: "macwine connect epic --code-stdin"}' \
        || echo "Sign in at $EPIC_LOGIN_URL, then run: macwine connect epic --code-stdin  (and paste the authorizationCode)"
      exit 0
    fi
    if [ "$store" = gog ]; then
      # GOG: user signs in on gog.com; the final address (embed.gog.com/on_login_success?code=...) carries a one-time code.
      gogdl_bin >/dev/null
      [ "$JSON" = 1 ] && "$JQ" -n --arg u "$GOG_LOGIN_URL" '{store: "gog", loginURL: $u, next: "macwine connect gog --code-stdin"}' \
        || echo "Sign in at $GOG_LOGIN_URL, then run: macwine connect gog --code-stdin  (and paste the address of the final page)"
      exit 0
    fi
    # Sign-in always happens in the store's own launcher - MacWine never sees the password.
    if [ "$DETACH" = 1 ]; then exec "$SELF" setup-store "$b" "$store" --detach; fi
    exec "$SELF" setup-store "$b" "$store"
    ;;
  sync)
    store="${1:-}"; [ -n "$store" ] || die "usage: macwine sync <store>"
    b="$(store_bottle "$store")"; [ -n "$b" ] || die "$store is not connected"
    case "$store" in
      steam)
        steam_sync_or_die "$b"
        [ "$JSON" = 1 ] && "$JQ" '{store: "steam", owned: length}' "$ACCOUNTS/steam/owned.json" || echo "Steam: $("$JQ" length "$ACCOUNTS/steam/owned.json") owned games" ;;
      gog)
        n="$(gog_library_json "$b" | "$JQ" length)"
        [ "$JSON" = 1 ] && echo "{\"store\":\"gog\",\"owned\":$n}" || echo "GOG: $n games" ;;
      *) [ "$JSON" = 1 ] && echo "{\"store\":\"$store\",\"owned\":null}" || echo "$store: only installed games are available" ;;
    esac
    ;;
  disconnect)
    store="${1:-}"
    case "$store" in steam|epic|gog|ubisoft) ;; *) die "usage: macwine disconnect steam|epic|gog|ubisoft" ;; esac
    rm -f "${ACCOUNTS:?}/$store/bottle" "${ACCOUNTS:?}/$store/owned.json"
    [ "$store" = steam ] && security delete-generic-password -s MacWine -a steam-apikey >/dev/null 2>&1 || true
    if [ "$store" = epic ] && epic_signed_in; then "$(legendary_bin)" auth --delete >/dev/null 2>&1 || true; fi
    [ "$store" = gog ] && rm -f "${ACCOUNTS:?}/gog/auth.json" "${ACCOUNTS:?}/gog/user.json" "${ACCOUNTS:?}/gog/owned.ok"
    [ "$JSON" = 1 ] && echo "{\"store\":\"$store\",\"connected\":false}" || echo "$store disconnected (local link only)"
    ;;
  set-key)
    [ "${1:-}" = steam ] || die "usage: macwine set-key steam   (the key is read from stdin)"
    if [ -t 0 ]; then printf 'Steam Web API key (https://steamcommunity.com/dev/apikey): ' >&2; read -rs key; echo >&2
    else read -r key; fi
    [[ "$key" =~ ^[0-9A-Fa-f]{32}$ ]] || die "this does not look like a Steam Web API key (32 hex characters)"
    # Passed to "security -i" on stdin so the key never appears in the process list.
    printf 'add-generic-password -U -s MacWine -a steam-apikey -w %s\n' "$key" | security -i >/dev/null
    unset key
    rm -f "${ACCOUNTS:?}/steam/owned.json"
    [ "$JSON" = 1 ] && echo '{"store":"steam","key":true}' || echo "Steam Web API key saved to the Keychain"
    ;;
  d3dmetal)
    sub="${1:-status}"
    case "$sub" in
      status)
        if d3dmetal_installed; then inst=true; else inst=false; fi
        if [ "$JSON" = 1 ]; then "$JQ" -n --argjson i "$inst" --arg s "$(cat "$D3DM_GPTK/source" 2>/dev/null)" '{installed: $i, source: (if $s=="" then null else $s end)}'
        else echo "D3DMetal installed: $inst"; fi ;;
      import)
        src="${2:-}"; [ -e "$src" ] || die "usage: macwine d3dmetal import <Game Porting Toolkit .dmg or folder>"
        mnt=(); search=("$src")
        cleanup_mounts() { local m; for m in ${mnt[@]+"${mnt[@]}"}; do hdiutil detach -quiet "$m" 2>/dev/null || true; done; }
        trap cleanup_mounts EXIT
        found=""
        # The toolkit .dmg may contain another .dmg ("Evaluation environment for Windows games")
        for _ in 1 2 3; do
          next=()
          for item in "${search[@]}"; do
            if [ -f "$item" ] && [[ "$item" == *.dmg ]]; then
              m="$(mktemp -d)"; hdiutil attach -nobrowse -readonly -quiet -mountpoint "$m" "$item" || die "cannot open $item"
              mnt+=("$m"); item="$m"
            fi
            [ -d "$item" ] || continue
            lib="$(find "$item" -maxdepth 6 -name libd3dshared.dylib -path '*/external/*' 2>/dev/null | head -1)"
            if [ -n "$lib" ]; then found="$(dirname "$(dirname "$lib")")"; break 2; fi
            while IFS= read -r d; do next+=("$d"); done < <(find "$item" -maxdepth 3 -name '*.dmg' 2>/dev/null)
          done
          [ ${#next[@]} -gt 0 ] || break
          search=("${next[@]}")
        done
        [ -n "$found" ] && [ -f "$found/wine/x86_64-unix/d3d12.so" ] || die "D3DMetal was not found in $src (expected redist/lib/external and redist/lib/wine)"
        rm -rf "${D3DM_DIR:?}/.gptk.tmp"; mkdir -p "$D3DM_DIR/.gptk.tmp"
        ditto "$found/external" "$D3DM_DIR/.gptk.tmp/external"
        ditto "$found/wine" "$D3DM_DIR/.gptk.tmp/wine"
        echo "$(basename "$src")" > "$D3DM_DIR/.gptk.tmp/source"
        rm -rf "${D3DM_GPTK:?}"; mv "$D3DM_DIR/.gptk.tmp" "$D3DM_GPTK"
        xattr -dr com.apple.quarantine "$D3DM_GPTK" 2>/dev/null || true
        [ "$JSON" = 1 ] && echo '{"installed":true}' || echo "D3DMetal imported. Enable it per bottle: macwine set <bottle> graphics d3dmetal" ;;
      *) die "usage: macwine d3dmetal status | import <Game Porting Toolkit .dmg or folder>" ;;
    esac
    ;;
  components)
    sub="${1:-list}"
    case "$sub" in
      list)
        if [ "$JSON" = 1 ]; then
          printf '%s\n' "$COMPONENTS" | "$JQ" -R -s '[split("\n")[] | select(length>0) | split("|") | {id: .[0], name: .[2], description: .[3]}]'
        else printf '%s\n' "$COMPONENTS" | awk -F'|' '{printf "%-16s %s - %s\n", $1, $3, $4}'; fi ;;
      install)
        need_bottle "${2:-}"; b="$2"; shift 2
        [ $# -gt 0 ] || die "usage: macwine components install <bottle> <component...>"
        verbs=()
        for c in "$@"; do
          v="$(printf '%s\n' "$COMPONENTS" | awk -F'|' -v id="$c" '$1==id {print $2}')"
          [ -n "$v" ] || die "unknown component: $c (see: macwine components list)"
          verbs+=("$v")
        done
        setup_env "$b"; wt="$(winetricks_bin)"
        mkdir -p "$MACWINE_HOME/logs"; log="$MACWINE_HOME/logs/components-$b.log"
        export WINE WINESERVER WINEPREFIX PATH="$TOOLS:$PATH" W_OPT_UNATTENDED=1
        [ "$JSON" = 1 ] && "$JQ" -n --arg l "$log" '{log: $l}'
        if [ "$DETACH" = 1 ]; then nohup "$wt" -q "${verbs[@]}" > "$log" 2>&1 & disown || true; exit 0; fi
        "$wt" -q "${verbs[@]}" 2>&1 | tee "$log" >&2
        "$WINESERVER" -w ;;
      *) die "usage: macwine components list | install <bottle> <component...>" ;;
    esac
    ;;
  cfg)
    need_bottle "${1:-}"; setup_env "$1"
    wine_start winecfg
    ;;
  kill)
    need_bottle "${1:-}"; setup_env "$1"
    "$WINESERVER" -k 2>/dev/null || true
    ;;
  version)
    wv="$("$WINE" --version 2>/dev/null || echo unknown)"
    dv="$(strings -a "$RUNTIME/lib/dxvk/x86_64-windows/d3d11.dll" 2>/dev/null | grep -E '^v[0-9]+\.[0-9]+' | head -1)" || true
    dv="${dv:-unknown}"
    mv="$(cat "$RUNTIME/lib/macwine/moltenvk-version" 2>/dev/null || echo unknown)"
    mw="$(cat "$RUNTIME/lib/macwine/version" 2>/dev/null || echo dev)"
    if [ "$JSON" = 1 ]; then
      printf '{"macwine":%s,"wine":%s,"dxvk":%s,"moltenvk":%s}\n' "$(json_str "$mw")" "$(json_str "${wv#wine-}")" "$(json_str "${dv#v}")" "$(json_str "$mv")"
    else echo "MacWine $mw, Wine ${wv#wine-}, DXVK ${dv#v}, MoltenVK $mv"; fi
    ;;
  dxvk) # reinstalls DXVK and its registry settings in the bottle
    need_bottle "${1:-}"; setup_env "$1"
    install_dxvk
    conf_set "$1" graphics dxvk
    echo "DXVK installed in bottle '$1'"
    ;;
  compat) # writes the compatibility rules into the bottle
    need_bottle "${1:-}"; setup_env "$1"
    install_compat
    echo "Compatibility rules written to bottle '$1'"
    ;;
  fps) # original command, same as: macwine set <bottle> fps <n>
    exec "$SELF" set "${1:-}" fps "${2:-}"
    ;;
  *)
    sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'
    [ -z "$cmd" ] || exit 1
    ;;
esac
