    leg="$(legendary_bin)"
    # --platform Windows: on macOS Legendary otherwise lists only games that have a Mac version
    owned="$("$leg" list --json --platform Windows 2>/dev/null | "$JQ" -c 'if type == "array" then
        map({app_name, app_title, metadata: {keyImages: (.metadata.keyImages // [] | map(select(.type == "DieselGameBoxTall" or .type == "DieselGameBox")))}})
      else empty end')" && [ -n "$owned" ] \
      || { rm -f "$ACCOUNTS/epic/owned.ok"; die "Epic: could not load the library (the sign-in may have expired - connect Epic again)"; }
    inst="$("$leg" list-installed --json 2>/dev/null)" && printf '%s' "$inst" | "$JQ" -e 'type == "array"' >/dev/null \
      || die "Epic: could not read installed games"
    inst="$(printf '%s' "$inst" | "$JQ" 'map({key: .app_name, value: .}) | from_entries')"
    date +%s > "$ACCOUNTS/epic/owned.ok"
  fi
  "$JQ" -n --argjson owned "$owned" --argjson inst "$inst" --argjson launcher "$launcher" --arg bottle "$1" '
    def art(m): ((m.keyImages // []) | (map(select(.type=="DieselGameBoxTall")) + map(select(.type=="DieselGameBox"))) | first | .url) // null;
    ($owned | map(.app_name)) as $O |
    [ $owned[] | {id: .app_name, name: .app_title, installed: ($inst[.app_name] != null),
