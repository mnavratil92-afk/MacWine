diff -ru a/dlls/advapi32/advapi.c b/dlls/advapi32/advapi.c
--- a/dlls/advapi32/advapi.c	2026-10-12 21:31:30
+++ b/dlls/advapi32/advapi.c	2026-10-12 21:31:30
@@ -48,11 +48,11 @@
     DWORD len = GetEnvironmentVariableA( "WINEUSERNAME", name, *size );
     BOOL ret;
 
-    /* CrossOver Hack 12735: Use a consistent username */
-    if (!getenv( "CX_REPORT_REAL_USERNAME" ))
+    /* MacWine: one consistent user name in every bottle, so bottles can move between Macs and users */
+    if (!getenv( "MACWINE_REAL_USERNAME" ))
     {
-        len = sizeof("crossover");
-        if ((ret = (len <= *size))) strcpy( name, "crossover" );
+        len = sizeof("macwine");
+        if ((ret = (len <= *size))) strcpy( name, "macwine" );
         else SetLastError( ERROR_INSUFFICIENT_BUFFER );
         *size = len;
         return ret;
@@ -73,11 +73,11 @@
     DWORD len = GetEnvironmentVariableW( L"WINEUSERNAME", name, *size );
     BOOL ret;
 
-    /* CrossOver Hack 12735: Use a consistent username */
-    if (!getenv( "CX_REPORT_REAL_USERNAME" ))
+    /* MacWine: one consistent user name in every bottle, so bottles can move between Macs and users */
+    if (!getenv( "MACWINE_REAL_USERNAME" ))
     {
-        len = ARRAY_SIZE( L"crossover" );
-        if ((ret = (len <= *size))) wcscpy( name, L"crossover" );
+        len = ARRAY_SIZE( L"macwine" );
+        if ((ret = (len <= *size))) wcscpy( name, L"macwine" );
         else SetLastError( ERROR_INSUFFICIENT_BUFFER );
         *size = len;
         return ret;
