+/* MacWine: compatibility rules for specific programs.
+ * HKCU\Software\MacWine\Compat\<name.exe>
+ *   AppendArgs   (REG_SZ)       arguments appended to the command line
+ *   ForbiddenArg (REG_SZ)       if present in the command line, AppendArgs is not applied
+ *   Environment  (REG_MULTI_SZ) NAME=VALUE entries added to the program's environment
+ * Returns a new command line (allocated on the process heap) or NULL. */
+static WCHAR *macwine_compat_cmdline( const WCHAR *app_name, const WCHAR *cmdline )
+{
+    WCHAR key[MAX_PATH + 40], append[1024], forbidden[256];
+    const WCHAR *base, *p;
+    DWORD size;
+    WCHAR *ret;
+    HKEY hkey;
+
+    if (!app_name || !cmdline) return NULL;
+    for (base = p = app_name; *p; p++) if (*p == '\\' || *p == '/') base = p + 1;
+    if (lstrlenW( base ) >= MAX_PATH) return NULL;
+    swprintf( key, ARRAY_SIZE(key), L"Software\\MacWine\\Compat\\%s", base );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, key, 0, KEY_READ, &hkey )) return NULL;
+
+    size = sizeof(append);
+    if (RegQueryValueExW( hkey, L"AppendArgs", NULL, NULL, (BYTE *)append, &size ) || !append[0])
+    {
+        RegCloseKey( hkey );
+        return NULL;
+    }
+    size = sizeof(forbidden);
+    if (!RegQueryValueExW( hkey, L"ForbiddenArg", NULL, NULL, (BYTE *)forbidden, &size ) &&
+        forbidden[0] && wcsstr( cmdline, forbidden ))
+    {
+        RegCloseKey( hkey );
+        return NULL;
+    }
+    RegCloseKey( hkey );
+    if (wcsstr( cmdline, append )) return NULL;
+
+    size = lstrlenW( cmdline ) + lstrlenW( append ) + 2;
+    if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, size * sizeof(WCHAR) ))) return NULL;
+    swprintf( ret, size, L"%s %s", cmdline, append );
+    TRACE( "MacWine compat: %s -> %s\n", debugstr_w(cmdline), debugstr_w(ret) );
+    return ret;
+}
+
+/* MacWine: the "Environment" compat value. Builds a new Unicode environment block from the one the
+ * caller passed (or the current one) plus the program's NAME=VALUE entries, which replace variables
+ * of the same name. Wine turns it into the new process's Unix environment as well, so it also reaches
+ * Unix libraries such as MoltenVK - even when a launcher (e.g. Steam) starts the game.
+ * Returns the block (process heap) or NULL when there is nothing to add. */
+static WCHAR *macwine_compat_environment( const WCHAR *app_name, void *env, DWORD flags )
+{
+    WCHAR key[MAX_PATH + 40], extra[2048];
+    const WCHAR *base, *p, *src, *e, *x;
+    WCHAR *cur = NULL, *ret, *dst;
+    DWORD size = sizeof(extra) - 2 * sizeof(WCHAR), type;
+    SIZE_T len_src, len_extra;
+    HKEY hkey;
+
+    if (!app_name) return NULL;
+    if (env && !(flags & CREATE_UNICODE_ENVIRONMENT)) return NULL; /* leave ANSI blocks alone */
+    for (base = p = app_name; *p; p++) if (*p == '\\' || *p == '/') base = p + 1;
+    if (lstrlenW( base ) >= MAX_PATH) return NULL;
+    swprintf( key, ARRAY_SIZE(key), L"Software\\MacWine\\Compat\\%s", base );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, key, 0, KEY_READ, &hkey )) return NULL;
+    memset( extra, 0, sizeof(extra) );
+    if (RegQueryValueExW( hkey, L"Environment", NULL, &type, (BYTE *)extra, &size ) ||
+        type != REG_MULTI_SZ || !extra[0])
+    {
+        RegCloseKey( hkey );
+        return NULL;
+    }
+    RegCloseKey( hkey );
+
+    if (!(src = env ? env : (cur = GetEnvironmentStringsW()))) return NULL;
+    for (e = src; *e; e += lstrlenW( e ) + 1);
+    len_src = e - src;
+    for (e = extra; *e; e += lstrlenW( e ) + 1);
+    len_extra = e - extra;
+
+    if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, (len_src + len_extra + 1) * sizeof(WCHAR) )))
+    {
+        if (cur) FreeEnvironmentStringsW( cur );
+        return NULL;
+    }
+    dst = ret;
+    for (e = src; *e; e += lstrlenW( e ) + 1)
+    {
+        const WCHAR *eq = wcschr( e + 1, '=' ); /* names of hidden variables start with '=' */
+        SIZE_T name_len = eq ? eq - e : lstrlenW( e );
+        BOOL replaced = FALSE;
+
+        for (x = extra; *x; x += lstrlenW( x ) + 1)
+            if (!wcsnicmp( x, e, name_len ) && x[name_len] == '=') { replaced = TRUE; break; }
+        if (replaced) continue;
+        lstrcpyW( dst, e );
+        dst += lstrlenW( e ) + 1;
+    }
+    for (x = extra; *x; x += lstrlenW( x ) + 1)
+    {
+        if (!wcschr( x, '=' )) continue;
+        lstrcpyW( dst, x );
+        dst += lstrlenW( x ) + 1;
+    }
+    *dst = 0;
+    if (cur) FreeEnvironmentStringsW( cur );
+    TRACE( "MacWine compat: environment for %s extended\n", debugstr_w(base) );
+    return ret;
+}
+
